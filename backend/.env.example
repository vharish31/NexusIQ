# ==============================================================================
# NexusIQ Backend - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your .env file or credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list of frontend URLs)
# Example: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Firebase Firestore Configuration
# Provide either the absolute or relative path to your service account key JSON file
# Or rely on Google Application Default Credentials (ADC) if running in GCP
FIREBASE_PROJECT_ID=nexusiq-2fe97
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIREBASE_DATABASE_URL=https://nexusiq-2fe97.firebaseio.com

# Bifrost AI Gateway Configuration
BIFROST_BASE_URL=http://localhost:8080
# Use your Bifrost Admin credentials (email/username & password)
BIFROST_USERNAME=admin@example.com
BIFROST_PASSWORD=your_bifrost_admin_password
# Or supply BIFROST_API_KEY with "username:password" or base64 token
BIFROST_API_KEY=
BIFROST_DEFAULT_MODEL=gemini/gemini-1.5-flash
BIFROST_TIMEOUT_SECONDS=30.0

# Tavily Search API Configuration
# Get your API key from https://app.tavily.com
TAVILY_API_KEY=tvly-your_tavily_api_key_here
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT_SECONDS=20.0

