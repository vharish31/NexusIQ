# NexusAI Environment Variables
# Notice: Do NOT commit production credentials or API keys directly to repository.

# API Base URL (leave blank to use simulated verification telemetry)
VITE_API_BASE_URL=

# Environment mode ('development' | 'production' | 'staging')
VITE_APP_ENV=development

# Optional Backend Integration Toggle
VITE_USE_REAL_API=false
