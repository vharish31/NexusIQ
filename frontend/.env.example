# NexusIQ Frontend Environment Variables
# Notice: Backend API keys (Firebase, Bifrost, Tavily) remain strictly on the backend server.

# Backend FastAPI Base URL (or '/api' when using Vite dev proxy)
VITE_API_BASE_URL=http://localhost:8000/api

# Environment mode ('development' | 'production' | 'staging')
VITE_APP_ENV=development

# Backend Integration Toggle
VITE_USE_REAL_API=true
